{
  "version": 8,
  "name": "GIS Skills synthetic symbology test",
  "sources": {
    "synthetic": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": {
              "kind": "Station",
              "rain_mm": 20
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                30,
                29
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "kind": "River"
            },
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  29.8,
                  29.5
                ],
                [
                  30.1,
                  29.7
                ],
                [
                  30.4,
                  29.6
                ]
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "kind": "Area"
            },
            "geometry": {
              "type": "Polygon",
              "coordinates": [
                [
                  [
                    29.6,
                    28.9
                  ],
                  [
                    30.2,
                    28.9
                  ],
                  [
                    30.2,
                    29.3
                  ],
                  [
                    29.6,
                    29.3
                  ],
                  [
                    29.6,
                    28.9
                  ]
                ]
              ]
            }
          }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "areas",
      "type": "fill",
      "source": "synthetic",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#82B39F",
        "fill-opacity": 0.55,
        "fill-outline-color": "#28624D"
      }
    },
    {
      "id": "rivers",
      "type": "line",
      "source": "synthetic",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#167DC1",
        "line-width": 3
      }
    },
    {
      "id": "stations",
      "type": "circle",
      "source": "synthetic",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "paint": {
        "circle-radius": 6,
        "circle-color": "#E5A13F",
        "circle-stroke-color": "#6D4F28",
        "circle-stroke-width": 1.5
      }
    }
  ]
}
