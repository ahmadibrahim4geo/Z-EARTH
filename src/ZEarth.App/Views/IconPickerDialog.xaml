<Window x:Class="ZEarth.App.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Icon"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Selected Preview -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Control.Background}"
                BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectedIconPreviewBorder" Width="44" Height="44" CornerRadius="4"
                        Background="#1E293B" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2"
                        Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedIconGlyph" Text="📍" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedIconNameText" Text="Selected: Pin" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="Click any symbol below to choose a visual marker for this feature."
                               FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Symbols Palette Grid -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Control.Background}"
                BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                CornerRadius="6" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="SymbolsWrapPanel" ItemWidth="52" ItemHeight="52" Margin="2"/>
            </ScrollViewer>
        </Border>

        <!-- Scale & Opacity Settings -->
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Scale:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
            <Slider Grid.Column="1" x:Name="ScaleSlider" Minimum="0.5" Maximum="3.0" Value="1.0"
                    TickFrequency="0.25" IsSnapToTickEnabled="True" Margin="0,0,12,0" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2" Text="Opacity:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
            <Slider Grid.Column="3" x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0"
                    TickFrequency="0.1" VerticalAlignment="Center"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Height="28" FontWeight="SemiBold"
                    Background="{DynamicResource Brush.Accent}" Foreground="#FFFFFF"
                    BorderThickness="0" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" Height="28"
                    Background="{DynamicResource Brush.Control.Background}"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    BorderBrush="{DynamicResource Brush.Control.Border}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
