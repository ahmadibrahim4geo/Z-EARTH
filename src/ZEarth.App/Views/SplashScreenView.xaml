<Window x:Class="ZEarth.App.Views.SplashScreenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZEarth.App.ViewModels"
        mc:Ignorable="d"
        Title="Z EARTH Desktop GIS - Loading"
        Height="380" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.DataContext>
        <vm:SplashViewModel />
    </Window.DataContext>

    <Border CornerRadius="14" BorderThickness="1.5" Margin="10">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22A8DE" Offset="0.0"/>
                <GradientStop Color="#45484D" Offset="0.5"/>
                <GradientStop Color="#252629" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#303236" Offset="0.0"/>
                <GradientStop Color="#252629" Offset="0.6"/>
                <GradientStop Color="#1E1F21" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="32,24,32,20">
            <Grid.RowDefinitions>
                <!-- Approved Brand Image Header -->
                <RowDefinition Height="Auto"/>
                <!-- Developer Credit -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer -->
                <RowDefinition Height="*"/>
                <!-- Progress & Status / Error UI -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Approved Z EARTH Logo (Icon + Wordmark + Blue Triangle in A + DESKTOP GIS) -->
            <Image Grid.Row="0" Source="/Assets/zearth_approved_logo_dark_theme.png"
                   Height="135" HorizontalAlignment="Center" Margin="0,4,0,4"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Developer Credit -->
            <TextBlock Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0"
                       FontSize="13" Foreground="#D0D3D6" FontFamily="Segoe UI">
                Developed by <Run FontWeight="SemiBold" Foreground="#22A8DE">Ahmad Ibrahim</Run>
            </TextBlock>

            <!-- Loading Status & Progress Bar (Visible when NOT Error) -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#22A8DE" FontFamily="Segoe UI"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding VersionString}" FontSize="11" Foreground="#9EA3A8" Margin="0,0,12,0" FontFamily="Segoe UI"/>
                        <!-- Cancel Button (ZE-007) -->
                        <Button Content="Cancel (Esc)" Click="CancelButton_Click" Cursor="Hand"
                                FontSize="10.5" Foreground="#D0D3D6" Background="#393B40" BorderBrush="#45484D"
                                BorderThickness="1" Padding="6,1" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="5"
                             BorderThickness="0" Background="#45484D" Foreground="#22A8DE"/>
            </StackPanel>

            <!-- Error UI (Visible only when IsError == true) -->
            <Border Grid.Row="3" Background="#3B2020" BorderBrush="#EF4444" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                    Visibility="{Binding IsError, Converter={x:Static vm:SplashViewModel.BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Startup Error" FontWeight="Bold" Foreground="#EF4444" FontSize="12"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Exit" Click="ExitButton_Click" Width="60" Height="26"
                            Background="#EF4444" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"
                            BorderThickness="0" Cursor="Hand" Margin="8,0,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
