<UserControl x:Class="ZEarth.App.Views.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="112" Height="24">
    <Grid>
        <ToggleButton x:Name="DropDownToggle"
                      Background="{DynamicResource Brush.Control.Background}"
                      BorderBrush="{DynamicResource Brush.Control.Border}"
                      BorderThickness="1" Padding="4,2" Cursor="Hand"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="Choose grid colour">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SwatchBorder" Grid.Column="0" Height="18" CornerRadius="3"
                        BorderBrush="#66000000" BorderThickness="1" Background="#FFFFFF"/>
                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="{DynamicResource Brush.Text.Primary}" Margin="8,0,2,0"
                      VerticalAlignment="Center"/>
            </Grid>
        </ToggleButton>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=DropDownToggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=DropDownToggle, Mode=TwoWay}">
            <Border Background="{DynamicResource Brush.Ribbon.Background}"
                    BorderBrush="{DynamicResource Brush.Control.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                <StackPanel Width="196">
                    <TextBlock Text="Grid colour" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6"/>
                    <UniformGrid x:Name="SwatchGrid" Columns="6" Margin="0,0,0,8"/>
                    <TextBox x:Name="HexInput" Height="26" MaxLength="9"
                             Background="{DynamicResource Brush.Control.Background}"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             BorderBrush="{DynamicResource Brush.Control.Border}"
                             ToolTip="Hex colour (#RRGGBB or #AARRGGBB)"
                             KeyDown="OnHexKeyDown"/>
                    <TextBlock x:Name="ValidationText" FontSize="10" Foreground="#F87171"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <Button Content="Apply" Width="70" Height="26" Margin="0,8,0,0"
                            HorizontalAlignment="Right" Click="OnApplyClick"
                            Background="{DynamicResource Brush.Accent}" Foreground="#FFFFFF"
                            BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
