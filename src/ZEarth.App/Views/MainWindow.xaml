<Window x:Class="ZEarth.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:domain="clr-namespace:ZEarth.Domain;assembly=ZEarth.Domain"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="850" Width="1380"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">

    <!-- Global Keyboard Accelerators (ZE-008, ZE-009, ZE-011) -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCollapseCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding ToggleSidebarDockCommand}"/>
        <KeyBinding Key="Home" Command="{Binding HomeCommand}"/>
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding FullExtentCommand}"/>
        <KeyBinding Key="F" Command="{Binding FitSelectionCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousExtentCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextExtentCommand}"/>
        <KeyBinding Key="F1" Command="{Binding AboutCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- Places TreeView Item Template -->
        <HierarchicalDataTemplate DataType="{x:Type domain:PlaceItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,1"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Fly To" Command="{Binding PlacementTarget.Tag.FlyToPlaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.FlyTo}" Style="{StaticResource MenuItemIconStyle}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Save to My Places" Command="{Binding PlacementTarget.Tag.SaveToMyPlacesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Save}" Style="{StaticResource MenuItemIconStyle}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Add Placemark" Command="{Binding PlacementTarget.Tag.AddPlacemarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Placemark}" Style="{StaticResource MenuItemIconStyle}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add Folder" Command="{Binding PlacementTarget.Tag.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource MenuItemIconStyle}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeletePlaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource MenuItemIconStyle}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource RibbonSmallIconStyle}" Margin="0,0,5,0"
                      Visibility="{Binding Children.Count, Converter={x:Null}}"/>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Ribbon Group Border & Header Style -->
        <Style x:Key="RibbonGroupBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ribbon.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="6,4,6,2"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <Style x:Key="RibbonGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Window.Background}">
        <Grid.RowDefinitions>
            <!-- Row 0: Title Bar & Quick Access Toolbar -->
            <RowDefinition Height="36"/>
            <!-- Row 1: GIS Ribbon Interface -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Main Workspace (Sidebar + Splitter + Globe Viewport) -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Two-Row Professional Status Bar (CRS-01..08) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TITLE BAR & QUICK ACCESS ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Window.Background}"
                BorderBrush="{DynamicResource Brush.Ribbon.Border}" BorderThickness="0,0,0,1" Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand & Approved Logo -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Quick Access Commands -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Document Title -->
                    <ColumnDefinition Width="*"/>
                    <!-- 3D/2D View Mode Pill -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Approved Branding Header -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,14,0">
                    <Image Source="/Assets/zearth_approved_icon.png" Width="20" Height="20" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Z" FontWeight="Bold" FontSize="14" Foreground="#009bff"/>
                    <TextBlock Text=" E" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid Margin="0.5,0">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <Polygon Points="4,7 5.5,4 7,7" Fill="#009bff"/>
                    </Grid>
                    <TextBlock Text="RTH" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text=" | DESKTOP GIS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Quick Access Toolbar Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding NewProjectCommand}" ToolTip="New Project (Ctrl+N)" AutomationProperties.AutomationId="ZE.Main.001.NewProjectCommand" AutomationProperties.Name="New Project (Ctrl+N)">
                        <Path Data="{StaticResource Icon.New}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding OpenProjectCommand}" ToolTip="Open Project (Ctrl+O)" AutomationProperties.AutomationId="ZE.Main.002.OpenProjectCommand" AutomationProperties.Name="Open Project (Ctrl+O)">
                        <Path Data="{StaticResource Icon.Open}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding SaveProjectCommand}" ToolTip="Save Project (Ctrl+S)" AutomationProperties.AutomationId="ZE.Main.003.SaveProjectCommand" AutomationProperties.Name="Save Project (Ctrl+S)">
                        <Path Data="{StaticResource Icon.Save}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Ribbon.Border}" Margin="4,0"/>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.AutomationId="ZE.Main.004.UndoCommand" AutomationProperties.Name="Undo (Ctrl+Z)">
                        <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.AutomationId="ZE.Main.005.RedoCommand" AutomationProperties.Name="Redo (Ctrl+Y)">
                        <Path Data="{StaticResource Icon.Redo}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Ribbon.Border}" Margin="4,0"/>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding HomeCommand}" ToolTip="Home View (Home)" AutomationProperties.AutomationId="ZE.Main.006.HomeCommand" AutomationProperties.Name="Home View (Home)">
                        <Path Data="{StaticResource Icon.Home}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding FullExtentCommand}" ToolTip="Full Global Extent (Ctrl+Shift+E)" AutomationProperties.AutomationId="ZE.Main.007.FullExtentCommand" AutomationProperties.Name="Full Global Extent (Ctrl+Shift+E)">
                        <Path Data="{StaticResource Icon.FullGlobe}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding PreviousExtentCommand}" ToolTip="Previous Extent (Alt+Left)" AutomationProperties.AutomationId="ZE.Main.008.PreviousExtentCommand" AutomationProperties.Name="Previous Extent (Alt+Left)">
                        <Path Data="{StaticResource Icon.PrevExtent}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding NextExtentCommand}" ToolTip="Next Extent (Alt+Right)" AutomationProperties.AutomationId="ZE.Main.009.NextExtentCommand" AutomationProperties.Name="Next Extent (Alt+Right)">
                        <Path Data="{StaticResource Icon.NextExtent}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Ribbon.Border}" Margin="4,0"/>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToggleLabel}" AutomationProperties.AutomationId="ZE.Main.010.ToggleThemeCommand" AutomationProperties.Name="Toggle Theme">
                        <Path Data="{StaticResource Icon.ThemeToggle}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ToggleSidebarCollapseCommand}" ToolTip="{Binding CollapseToggleLabel}" AutomationProperties.AutomationId="ZE.Main.011.ToggleSidebarCollapseCommand" AutomationProperties.Name="Toggle Sidebar Collapse">
                        <Path Data="{StaticResource Icon.SidebarToggle}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                </StackPanel>

                <!-- Center Document Title -->
                <TextBlock Grid.Column="2" Text="{Binding WindowTitle}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Right Controls: View Mode & Theme Toggle -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.Sidebar.Background}" CornerRadius="12"
                            BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" Padding="3,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="3D Globe" GroupName="SceneModeGroup" IsChecked="{Binding Is3DMode, Mode=TwoWay}"
                                         Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="11" Margin="4,0" AutomationProperties.AutomationId="ZE.Main.012.Is3DMode" AutomationProperties.Name="3D Globe view"/>
                            <RadioButton Content="2D Map" GroupName="SceneModeGroup" IsChecked="{Binding Is2DMode, Mode=TwoWay}"
                                         Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="11" Margin="4,0" AutomationProperties.AutomationId="ZE.Main.013.Is2DMode" AutomationProperties.Name="2D Map view"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding ThemeToggleLabel}" Margin="6,0,0,0" AutomationProperties.AutomationId="ZE.Main.014.ToggleThemeCommand" AutomationProperties.Name="Toggle Theme">
                        <Path Data="{StaticResource Icon.ThemeToggle}" Style="{StaticResource RibbonSmallIconStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: GIS RIBBON INTERFACE ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Ribbon.Background}"
                BorderBrush="{DynamicResource Brush.Ribbon.Border}" BorderThickness="0,0,0,1">
            <TabControl SelectedIndex="{Binding SelectedRibbonTab}" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="tabHeader" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,2,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tabHeader" Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tabHeader" Property="Background" Value="{DynamicResource Brush.Sidebar.Background}"/>
                                            <Setter TargetName="tabHeader" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 0: PROJECT -->
                <TabItem Header="Project">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Background="{DynamicResource Brush.Ribbon.Background}">
                    <StackPanel Orientation="Horizontal" Height="90" Background="{DynamicResource Brush.Ribbon.Background}" Margin="4,2">
                        <!-- Group: File Management -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding NewProjectCommand}" ToolTip="Create new empty GIS project (Ctrl+N)" AutomationProperties.AutomationId="ZE.Main.015.NewProjectCommand" AutomationProperties.Name="Create new empty GIS project (Ctrl+N)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="New" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding OpenProjectCommand}" ToolTip="Open existing project (Ctrl+O)" AutomationProperties.AutomationId="ZE.Main.016.OpenProjectCommand" AutomationProperties.Name="Open existing project (Ctrl+O)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📂" FontSize="20" HorizontalAlignment="Center" Foreground="#fbbf24"/>
                                            <TextBlock Text="Open" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding SaveProjectCommand}" ToolTip="Save project changes (Ctrl+S)" AutomationProperties.AutomationId="ZE.Main.017.SaveProjectCommand" AutomationProperties.Name="Save project changes (Ctrl+S)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center" Foreground="#34d399"/>
                                            <TextBlock Text="Save" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding SaveAsProjectCommand}" ToolTip="Save project with a new name" AutomationProperties.AutomationId="ZE.Main.018.SaveAsProjectCommand" AutomationProperties.Name="Save project with a new name">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📑" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                            <TextBlock Text="Save As" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Project File" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Group: Undo / Redo (Sprint 3) -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding UndoCommand}" ToolTip="Undo Last Action (Ctrl+Z)" AutomationProperties.AutomationId="ZE.Main.019.UndoCommand" AutomationProperties.Name="Undo Last Action (Ctrl+Z)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="Undo" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding RedoCommand}" ToolTip="Redo Reverted Action (Ctrl+Y)" AutomationProperties.AutomationId="ZE.Main.020.RedoCommand" AutomationProperties.Name="Redo Reverted Action (Ctrl+Y)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Redo}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="Redo" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="History" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Group: Import / Export -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ImportKmlCommand}" ToolTip="Import KML / KMZ into My Places" AutomationProperties.AutomationId="ZE.Main.021.ImportKmlCommand" AutomationProperties.Name="Import KML / KMZ into My Places">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.KmlImport}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="Import KML" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ImportGpxCommand}" ToolTip="{Binding GpsImportTooltip}" AutomationProperties.AutomationId="ZE.Main.021a.ImportGpxCommand" AutomationProperties.Name="{Binding GpsImportLabel}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="GPS" FontSize="18" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding GpsImportLabel}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding PlayGpsTrackCommand}" ToolTip="Replay time-tagged selected GPS track using original UTC timestamps (30 second preview)" AutomationProperties.AutomationId="ZE.Main.021b.PlayGpsTrackCommand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="▶" FontSize="21" Foreground="#34d399" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Play GPS" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding StopGpsTrackCommand}" ToolTip="Stop the current GPS track replay" AutomationProperties.AutomationId="ZE.Main.021c.StopGpsTrackCommand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="■" FontSize="18" Foreground="#f87171" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Stop GPS" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ExportKmlCommand}" ToolTip="Export current Places hierarchy to KML 2.2" AutomationProperties.AutomationId="ZE.Main.022.ExportKmlCommand" AutomationProperties.Name="Export current Places hierarchy to KML 2.2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.KmlExport}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#f472b6"/>
                                            <TextBlock Text="Export KML" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ExportKmzCommand}" ToolTip="Export current Places hierarchy to compressed KMZ bundle" AutomationProperties.AutomationId="ZE.Main.023.ExportKmzCommand" AutomationProperties.Name="Export current Places hierarchy to compressed KMZ bundle">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.KmzExport}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#38bdf8"/>
                                            <TextBlock Text="Export KMZ" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Interchange" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 1: NAVIGATION -->
                <TabItem Header="Navigation">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Background="{DynamicResource Brush.Ribbon.Background}">
                    <StackPanel Orientation="Horizontal" Height="90" Background="{DynamicResource Brush.Ribbon.Background}" Margin="4,2">
                        <!-- Group: Standard Views -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding HomeCommand}" ToolTip="{Binding HomeTooltip}" AutomationProperties.AutomationId="ZE.Main.024.HomeCommand" AutomationProperties.Name="Home">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Home}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="Home" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding FullExtentCommand}" ToolTip="Full Global Planetary View (Ctrl+Shift+E)" AutomationProperties.AutomationId="ZE.Main.025.FullExtentCommand" AutomationProperties.Name="Full Global Planetary View (Ctrl+Shift+E)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.FullGlobe}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#38bdf8"/>
                                            <TextBlock Text="Full Extent" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding FitSelectionCommand}" ToolTip="Fit Selection / Features to Viewport (F)" AutomationProperties.AutomationId="ZE.Main.026.FitSelectionCommand" AutomationProperties.Name="Fit Selection / Features to Viewport (F)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.FitSelection}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#fbbf24"/>
                                            <TextBlock Text="Fit View" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="2,0">
                                        <Button Style="{StaticResource RibbonSmallBtnStyle}" Command="{Binding PreviousExtentCommand}" ToolTip="Previous Extent (Alt+Left)" AutomationProperties.AutomationId="ZE.Main.027.PreviousExtentCommand" AutomationProperties.Name="Previous Extent (Alt+Left)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.PrevExtent}" Style="{StaticResource RibbonSmallIconStyle}" Fill="{DynamicResource Brush.Accent}" Margin="0,0,4,0"/>
                                                <TextBlock Text="Previous"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonSmallBtnStyle}" Command="{Binding NextExtentCommand}" ToolTip="Next Extent (Alt+Right)" AutomationProperties.AutomationId="ZE.Main.028.NextExtentCommand" AutomationProperties.Name="Next Extent (Alt+Right)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.NextExtent}" Style="{StaticResource RibbonSmallIconStyle}" Fill="{DynamicResource Brush.Accent}" Margin="0,0,4,0"/>
                                                <TextBlock Text="Next"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Extent History" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Group: Camera & Orientation -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
