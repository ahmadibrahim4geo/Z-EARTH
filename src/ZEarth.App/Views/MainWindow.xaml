                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding MeasureDistanceCommand}" ToolTip="Interactive geodesic line distance and 3D slope measurement (ZE-046, ZE-047)" AutomationProperties.AutomationId="ZE.Main.059.MeasureDistanceCommand" AutomationProperties.Name="Interactive geodesic line distance and 3D slope measurement (ZE-046, ZE-047)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.MeasureDistance}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="Distance" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding MeasureAreaCommand}" ToolTip="Polygon surface area &amp; perimeter measurement (ZE-046)" AutomationProperties.AutomationId="ZE.Main.060.MeasureAreaCommand" AutomationProperties.Name="Polygon surface area &amp; perimeter measurement (ZE-046)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.MeasureArea}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#34d399"/>
                                            <TextBlock Text="Area" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ElevationProfileCommand}" ToolTip="Topographic elevation profile along measured path" AutomationProperties.AutomationId="ZE.Main.061.ElevationProfileCommand" AutomationProperties.Name="Topographic elevation profile along measured path">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.ElevationProfile}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#38bdf8"/>
                                            <TextBlock Text="Profile" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ClearMeasurementCommand}" ToolTip="Clear active measurement overlays and results" AutomationProperties.AutomationId="ZE.Main.062.ClearMeasurementCommand" AutomationProperties.Name="Clear active measurement overlays and results">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.ClearMeasure}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#f87171"/>
                                            <TextBlock Text="Clear" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Geodesic Tools" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Group 2: Snapping Engine (ZE-042, ZE-043, ZE-044) -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <CheckBox Content="Enable Snapping" IsChecked="{Binding IsSnapEnabled}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Ground Tol:" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox SelectedValue="{Binding SnapToleranceTag}" SelectedValuePath="Tag" Width="72" Height="22" FontSize="10.5">
                                                <ComboBoxItem Content="1 m" Tag="1"/>
                                                <ComboBoxItem Content="3 m" Tag="3"/>
                                                <ComboBoxItem Content="5 m" Tag="5" IsSelected="True"/>
                                                <ComboBoxItem Content="10 m" Tag="10"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" IsEnabled="{Binding IsSnapEnabled}">
                                        <CheckBox Content="Vertex / Endpoints" IsChecked="{Binding SnapToVertices}" FontSize="10" Margin="0,1"/>
                                        <CheckBox Content="Segment Midpoints" IsChecked="{Binding SnapToMidpoints}" FontSize="10" Margin="0,1"/>
                                        <CheckBox Content="Edge Nearest Projection" IsChecked="{Binding SnapToEdges}" FontSize="10" Margin="0,1"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Snapping Engine" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Group 3: Active Readout Card -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}" MinWidth="260">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="GEODESIC METRICS (WGS 84)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding ActiveMeasurementInfo}" FontSize="11" TextWrapping="Wrap" MaxWidth="290" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Telemetry" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 5: LAYERS (ZE-048, ZE-049, ZE-052) -->
                <TabItem Header="Basemap">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Background="{DynamicResource Brush.Ribbon.Background}">
                    <StackPanel Orientation="Horizontal" Height="90" Background="{DynamicResource Brush.Ribbon.Background}" Margin="4,2">
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding OpenBasemapGalleryCommand}"
                                        ToolTip="Search, filter and compare the basemaps" AutomationProperties.AutomationId="ZE.Main.063.OpenBasemapGalleryCommand" AutomationProperties.Name="Search, filter and compare the basemaps">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource Icon.BasemapGallery}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Text="Browse All" FontSize="11" TextAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Row="1" Text="Basemap Gallery" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding AddImageryLayerCommand}"
                                        ToolTip="Connect custom WMS, WMTS or XYZ provider" AutomationProperties.AutomationId="ZE.Main.064.AddImageryLayerCommand" AutomationProperties.Name="Connect custom WMS, WMTS or XYZ provider">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Add}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Text="Add Service" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Row="1" Text="Custom Services" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="Active Basemap" FontWeight="SemiBold" FontSize="10"/>
                                <TextBlock Text="{Binding ActiveBasemap}" MaxWidth="220" TextWrapping="Wrap" FontSize="11"/>
                                <CheckBox Content="Political Borders" IsChecked="{Binding IsBordersVisible}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                
                    </ScrollViewer>
                </TabItem>

                <!-- Dedicated historical imagery workspace -->
                <TabItem Header="Historical Imagery">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Background="{DynamicResource Brush.Ribbon.Background}">
                    <StackPanel Orientation="Horizontal" Height="90" Background="{DynamicResource Brush.Ribbon.Background}" Margin="4,2">
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding HistoricalImageryCommand}" ToolTip="Open a small non-blocking timeline over the globe (Esc / × to close)" AutomationProperties.AutomationId="ZE.Main.065.HistoricalImageryCommand" AutomationProperties.Name="Open a small non-blocking timeline over the globe (Esc / × to close)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.BasemapGallery}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#a78bfa"/>
                                            <TextBlock Text="Show Timeline" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0" MaxWidth="330">
                                        <TextBlock Text="Esri World Imagery Wayback" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <TextBlock Text="Open the inline timeline: previous/next, drag date slider, choose year or day. Move the globe while it stays open." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Esri Wayback Release Timeline" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding NasaHistoricalImageryCommand}" ToolTip="Choose NASA MODIS Terra/Aqua dated observation imagery, not Google high-resolution historical images" AutomationProperties.AutomationId="ZE.Main.065a.NasaHistoricalImageryCommand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="NASA" FontSize="18" FontWeight="SemiBold" Foreground="#a3e635" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Dated MODIS" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ClearNasaHistoricalImageryCommand}" ToolTip="Remove the NASA daily imagery overlay and restore underlying layers" AutomationProperties.AutomationId="ZE.Main.065b.ClearNasaHistoricalImageryCommand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="×" FontSize="22" Foreground="#ef4444" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Hide NASA" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0" MaxWidth="280">
                                        <TextBlock Text="NASA GIBS — daily satellite observations" FontWeight="Bold"/>
                                        <TextBlock Text="Lower-resolution dated true-color imagery; cloud cover and missing dates may affect availability." FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Satellite Observation Dates (NASA)" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 6: TERRAIN (ZE-050, ZE-051, AC-019) -->
                <TabItem Header="Terrain">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Background="{DynamicResource Brush.Ribbon.Background}">
                    <StackPanel Orientation="Horizontal" Height="90" Background="{DynamicResource Brush.Ribbon.Background}" Margin="4,2">
                        <!-- Group 1: Elevation Model Selection -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ToggleTerrainCommand}" ToolTip="Turn the configured terrain model on or off. Choose the default model in Options." AutomationProperties.AutomationId="ZE.Main.066.ToggleTerrainCommand" AutomationProperties.Name="Turn the configured terrain model on or off. Choose the default model in Options.">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Terrain3D}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{Binding TerrainIconBrush}"/>
                                            <TextBlock Text="Terrain" FontSize="11" HorizontalAlignment="Center" Foreground="{Binding TerrainIconBrush}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding TerrainToggleState}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding TerrainIconBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="Selected Elevation Model:" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                        <TextBlock Text="{Binding TerrainProviderType}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TerrainIconBrush}" MaxWidth="160" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Elevation Model" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Group 2: Vertical Exaggeration (ZE-051, AC-019) -->
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center" IsEnabled="{Binding IsTerrainEnabled}">
                                    <StackPanel Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Exaggeration:" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding VerticalExaggerationDisplay}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                        </StackPanel>
                                        <Slider Minimum="0.2" Maximum="5.0" SmallChange="0.1" LargeChange="0.5" Width="130"
                                                Value="{Binding VerticalExaggeration, Mode=TwoWay}"
                                                ToolTip="Scale visual terrain relief without modifying geodetic measurements (AC-019)"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="1.0x" Command="{Binding SetVerticalExaggerationCommand}" CommandParameter="1.0" Width="36" Height="24" Margin="2,0" AutomationProperties.AutomationId="ZE.Main.067.SetVerticalExaggerationCommand" AutomationProperties.Name="Set Vertical Exaggeration - 1.0"/>
                                        <Button Content="2.0x" Command="{Binding SetVerticalExaggerationCommand}" CommandParameter="2.0" Width="36" Height="24" Margin="2,0" AutomationProperties.AutomationId="ZE.Main.068.SetVerticalExaggerationCommand" AutomationProperties.Name="Set Vertical Exaggeration - 2.0"/>
                                        <Button Content="3.0x" Command="{Binding SetVerticalExaggerationCommand}" CommandParameter="3.0" Width="36" Height="24" Margin="2,0" AutomationProperties.AutomationId="ZE.Main.069.SetVerticalExaggerationCommand" AutomationProperties.Name="Set Vertical Exaggeration - 3.0"/>
                                        <Button Content="5.0x" Command="{Binding SetVerticalExaggerationCommand}" CommandParameter="5.0" Width="36" Height="24" Margin="2,0" AutomationProperties.AutomationId="ZE.Main.070.SetVerticalExaggerationCommand" AutomationProperties.Name="Set Vertical Exaggeration - 5.0"/>
                                        <Button Content="Reset" Command="{Binding ResetVerticalExaggerationCommand}" Width="44" Height="24" Margin="4,0,2,0" Background="{DynamicResource Brush.Control.Background}" AutomationProperties.AutomationId="ZE.Main.071.ResetVerticalExaggerationCommand" AutomationProperties.Name="Reset Vertical Exaggeration"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Vertical Exaggeration (AC-019)" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 7: TOOLS -->
                <TabItem Header="Tools">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Background="{DynamicResource Brush.Ribbon.Background}">
                    <StackPanel Orientation="Horizontal" Height="90" Background="{DynamicResource Brush.Ribbon.Background}" Margin="4,2">
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ImportVectorCommand}" ToolTip="Import ESRI Shapefile (.shp), GeoPackage (.gpkg), or GeoJSON (.geojson) (ZE-053)" AutomationProperties.AutomationId="ZE.Main.072.ImportVectorCommand" AutomationProperties.Name="Import ESRI Shapefile (.shp), GeoPackage (.gpkg), or GeoJSON (.geojson) (ZE-053)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.VectorData}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#38bdf8"/>
                                            <TextBlock Text="Vector Data" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding ToggleLanguageCommand}" ToolTip="Toggle UI Language (English / العربية) and RTL layout (ZE-055)" AutomationProperties.AutomationId="ZE.Main.073.ToggleLanguageCommand" AutomationProperties.Name="Toggle UI Language (English / العربية) and RTL layout (ZE-055)">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.CrsGlobe}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="{Binding CurrentLanguageText}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding CoordinateConverterCommand}" ToolTip="Bidirectional coordinate converter between DD, DMS, UTM, and MGRS" AutomationProperties.AutomationId="ZE.Main.074.CoordinateConverterCommand" AutomationProperties.Name="Bidirectional coordinate converter between DD, DMS, UTM, and MGRS">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.CoordConverter}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="Coord Conv" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding TakeScreenshotCommand}" ToolTip="Export high-resolution map snapshot to file" AutomationProperties.AutomationId="ZE.Main.075.TakeScreenshotCommand" AutomationProperties.Name="Export high-resolution map snapshot to file">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.CameraSnapshot}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#38bdf8"/>
                                            <TextBlock Text="Snapshot" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding DiagnosticsCommand}" ToolTip="Display runtime diagnostics and memory logs" AutomationProperties.AutomationId="ZE.Main.076.DiagnosticsCommand" AutomationProperties.Name="Display runtime diagnostics and memory logs">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Diagnostics}" Style="{StaticResource RibbonLargeIconStyle}" Fill="#f472b6"/>
                                            <TextBlock Text="Diagnostics" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding OptionsCommand}" ToolTip="Configure application preferences, measurement units, snapping, and basemaps" AutomationProperties.AutomationId="ZE.Main.077.OptionsCommand" AutomationProperties.Name="Configure application preferences, measurement units, snapping, and basemaps">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Options}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Text.Secondary}"/>
                                            <TextBlock Text="Options" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Utilities" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 8: HELP -->
                <TabItem Header="Help">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" Background="{DynamicResource Brush.Ribbon.Background}">
                    <StackPanel Orientation="Horizontal" Height="90" Background="{DynamicResource Brush.Ribbon.Background}" Margin="4,2">
                        <Border Style="{StaticResource RibbonGroupBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonLargeBtnStyle}" Command="{Binding AboutCommand}" ToolTip="About Z EARTH Desktop and licensing" AutomationProperties.AutomationId="ZE.Main.078.AboutCommand" AutomationProperties.Name="About Z EARTH Desktop and licensing">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.About}" Style="{StaticResource RibbonLargeIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
                                            <TextBlock Text="About" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Information" Style="{StaticResource RibbonGroupHeaderStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ==================== ROW 2: MAIN WORKSPACE (SIDEBAR + SPLITTER + VIEWPORT) ==================== -->
        <Grid Grid.Row="2" x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left Column (Sidebar when docked left, or Viewport when docked right) -->
                <ColumnDefinition x:Name="ColLeft" Width="450" MinWidth="0" MaxWidth="740"/>
                <!-- Column 1: Resizable Splitter -->
                <ColumnDefinition x:Name="ColSplitter" Width="4"/>
                <!-- Column 2: Right Column (Viewport when docked left, or Sidebar when docked right) -->
                <ColumnDefinition x:Name="ColRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Collapsed Sidebar Reveal Button (Left Edge) -->
            <Button x:Name="RevealSidebarLeftBtn" Grid.Column="0" Command="{Binding ToggleSidebarCollapseCommand}"
                    Visibility="Collapsed" Width="26" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.Ribbon.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}"
                    BorderThickness="0,0,1,0" ToolTip="Expand Places &amp; Layers Sidebar (Ctrl+B)" Cursor="Hand" AutomationProperties.AutomationId="ZE.Main.079.ToggleSidebarCollapseCommand" AutomationProperties.Name="Expand Places &amp; Layers Sidebar (Ctrl+B)">
                <Path Data="{StaticResource Icon.NextExtent}" Style="{StaticResource RibbonSmallIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
            </Button>

            <!-- ==================== SIDEBAR PANELS ==================== -->
            <!-- ==================== COLUMN 0: SIDEBAR (SIDEBAR-01 Scope) ==================== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header Toolbar: Title, Expand/Collapse All, Dock, Pin -->
                        <RowDefinition Height="34"/>
                        <!-- Two supported top-level sections: Search and My Places -->
                        <RowDefinition Height="*"/>
                        <!-- Basemap controls live in the Basemap ribbon tab. -->
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Sidebar Header Toolbar -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Ribbon.Background}"
                            BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐 " FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="EXPLORER" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ExpandAllSectionsCommand}" ToolTip="Expand All Sections" AutomationProperties.AutomationId="ZE.Main.080.ExpandAllSectionsCommand" AutomationProperties.Name="Expand All Sections">
                                    <TextBlock Text="⊞" FontSize="12" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding CollapseAllSectionsCommand}" ToolTip="Collapse All Sections" AutomationProperties.AutomationId="ZE.Main.081.CollapseAllSectionsCommand" AutomationProperties.Name="Collapse All Sections">
                                    <TextBlock Text="⊟" FontSize="12" FontWeight="Bold"/>
                                </Button>
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Control.Border}" Margin="3,0"/>
                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ToggleSidebarDockCommand}" ToolTip="{Binding DockToggleLabel}" AutomationProperties.AutomationId="ZE.Main.082.ToggleSidebarDockCommand" AutomationProperties.Name="Toggle Sidebar Dock">
                                    <TextBlock Text="{Binding DockToggleIcon}" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ToggleSidebarCollapseCommand}" ToolTip="{Binding CollapseToggleLabel}" AutomationProperties.AutomationId="ZE.Main.083.ToggleSidebarCollapseCommand" AutomationProperties.Name="Toggle Sidebar Collapse">
                                    <TextBlock Text="{Binding CollapseToggleIcon}" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Unified Scrollable 4-Section Sidebar Container -->
                    <Grid Grid.Row="1" Margin="6" MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" MinHeight="42" MaxHeight="460"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- ==================== SECTION 1: SEARCH ==================== -->
                            <Expander IsExpanded="{Binding IsSearchExpanded, Mode=TwoWay}" Margin="0,0,0,8"
                                      Background="{DynamicResource Brush.Control.Background}"
                                      BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="🔍 " FontSize="12"/>
                                        <TextBlock Text="Search" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </DockPanel>
                                </Expander.Header>

                                <Border Background="{DynamicResource Brush.Window.Background}" Padding="8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Control.Border}">
                                    <StackPanel>
                                        <!-- Search Mode Tabs: [By Name] [By Coordinates] -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- By Name Toggle Button -->
                                            <RadioButton Grid.Column="0" Content="By Name" Style="{StaticResource SidebarTabBtnStyle}"
                                                         IsChecked="{Binding SelectedSearchMode, Converter={x:Null}, Mode=OneWay}"
                                                         Click="SearchModeByName_Click" Height="24" FontSize="11" AutomationProperties.AutomationId="ZE.Main.084.SearchModeByName_Click" AutomationProperties.Name="Search by place name"/>

                                            <!-- By Coordinates Toggle Button -->
                                            <RadioButton Grid.Column="1" Content="By Coordinates" Style="{StaticResource SidebarTabBtnStyle}"
                                                         Click="SearchModeByCoordinates_Click" Height="24" FontSize="11" AutomationProperties.AutomationId="ZE.Main.085.SearchModeByCoordinates_Click" AutomationProperties.Name="Search by coordinates"/>
                                        </Grid>

                                        <!-- MODE 0: BY NAME PANEL -->
                                        <StackPanel x:Name="SearchByNamePanel">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Text="{Binding SearchNameQuery, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         KeyDown="SearchByNameBox_KeyDown"
                                                         ToolTip="Enter city or place name (e.g., 'Cairo', 'القاهرة', 'Giza')"/>

                                                <Button Grid.Column="1" Command="{Binding SearchByNameCommand}"
                                                        Width="30" Height="26" Margin="4,0,0,0"
                                                        Background="{DynamicResource Brush.Control.Background}"
                                                        Foreground="{DynamicResource Brush.Accent}"
                                                        BorderBrush="{DynamicResource Brush.Control.Border}"
                                                        BorderThickness="1" Cursor="Hand" ToolTip="Search local places and online geocoder (Enter)" AutomationProperties.AutomationId="ZE.Main.086.SearchByNameCommand" AutomationProperties.Name="Search local places and online geocoder (Enter)">
                                                    🔍
                                                </Button>
                                                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Content="✕"
                                                        Width="30" Height="26" Margin="4,0,0,0"
                                                        Background="{DynamicResource Brush.Control.Background}"
                                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                                        BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                                                        ToolTip="Clear search query, results and messages" AutomationProperties.AutomationId="ZE.Main.087.ClearSearchCommand" AutomationProperties.Name="Clear search query, results and messages"/>
                                            </Grid>
                                            <TextBlock Text="Searches My Places + Temporary first, then online Photon."
                                                       FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="1,0,0,6"/>
                                        </StackPanel>

                                        <!-- MODE 1: BY COORDINATES PANEL (X STRICTLY ABOVE Y) -->
                                        <StackPanel x:Name="SearchByCoordsPanel" Visibility="Collapsed">
                                            <!-- CRS Selector -->
                                            <TextBlock Text="Target CRS / Projection:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,2"/>
                                            <ComboBox ItemsSource="{Binding AvailableSearchCrsList}"
                                                      SelectedValue="{Binding SelectedSearchCrsEpsg, Mode=TwoWay}"
                                                      SelectedValuePath="Epsg"
                                                      DisplayMemberPath="Display"
                                                      Height="24" FontSize="10.5" Margin="0,0,0,8"
                                                      Background="{DynamicResource Brush.Control.Background}"
                                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                                      BorderBrush="{DynamicResource Brush.Control.Border}"/>

                                            <!-- Field 1: X Coordinate (STRICTLY ABOVE Y) -->
                                            <TextBlock Text="{Binding SearchCoordinateXLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SearchCoordinateX, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="24" Padding="4,2" FontSize="11" Margin="0,0,0,6"
                                                     Background="{DynamicResource Brush.Control.Background}"
                                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                                     BorderBrush="{DynamicResource Brush.Control.Border}"
                                                     BorderThickness="1"
                                                     ToolTip="{Binding CoordinateFormatPlaceholderX}"/>

                                            <!-- Field 2: Y Coordinate (STRICTLY BELOW X) -->
                                            <TextBlock Text="{Binding SearchCoordinateYLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SearchCoordinateY, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="24" Padding="4,2" FontSize="11" Margin="0,0,0,8"
                                                     Background="{DynamicResource Brush.Control.Background}"
                                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                                     BorderBrush="{DynamicResource Brush.Control.Border}"
                                                     BorderThickness="1"
                                                     ToolTip="{Binding CoordinateFormatPlaceholderY}"/>

                                            <!-- Locate Button -->
                                            <Button Command="{Binding LocateCoordinatesCommand}" Content="🎯 Locate / Fly To"
                                                    Height="26" FontWeight="SemiBold" FontSize="11"
                                                    Background="{DynamicResource Brush.Accent}" Foreground="#FFFFFF"
                                                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,6" AutomationProperties.AutomationId="ZE.Main.088.LocateCoordinatesCommand" AutomationProperties.Name="Locate Coordinates"/>
                                            <Button Command="{Binding FindMyLocationCommand}" Content="◎ My Device Location (permission required)"
                                                    Height="28" Padding="6,2" Margin="0,0,0,8" FontSize="10.5"
                                                    Background="{DynamicResource Brush.Control.Background}"
                                                    Foreground="{DynamicResource Brush.Text.Primary}"
                                                    BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                                                    ToolTip="Request a one-time device location fix and fill WGS84 X/Y; no tracking" AutomationProperties.AutomationId="ZE.Main.089.FindMyLocationCommand" AutomationProperties.Name="Request a one-time device location fix and fill WGS84 X/Y; no tracking"/>
                                        </StackPanel>

                                        <!-- Validation / Status Message -->
                                        <TextBlock Text="{Binding CoordinateValidationMessage}" TextWrapping="Wrap"
                                                   FontSize="10" Margin="0,2,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#ef4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCoordinateValidationSuccess}" Value="True">
                                                            <Setter Property="Foreground" Value="#22c55e"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Command="{Binding ClearSearchCommand}" Content="Clear results"
                                                HorizontalAlignment="Right" Margin="0,0,0,5" Padding="8,3"
                                                Background="{DynamicResource Brush.Control.Background}"
                                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                                BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" AutomationProperties.AutomationId="ZE.Main.090.ClearSearchCommand" AutomationProperties.Name="Clear Search"/>
                                        <!-- Search Results List -->
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Brush.Control.Background}"
                                                            BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                                                            CornerRadius="3" Padding="6,4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Row 0: Title and Source Badge -->
                                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Icon}" FontSize="11" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Brush.Window.Background}" CornerRadius="2" Padding="4,1">
                                                                <TextBlock Text="{Binding SourceBadge}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                                                            </Border>

                                                            <!-- Row 1: Subtitle / Address -->
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Subtitle}"
                                                                       FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2"/>

                                                            <!-- Row 2: Action Buttons -->
                                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Button Content="✈ Fly To" Command="{Binding DataContext.FlyToSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                        Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                                        Background="{DynamicResource Brush.Accent}" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="ZE.Main.091.FlyToSearchResultCommand" AutomationProperties.Name="Fly To Search Result"/>
                                                                <Button Content="💾 My Places" Command="{Binding DataContext.SaveSearchResultToMyPlacesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                        Padding="6,1" FontSize="10" Margin="0,0,4,0"
                                                                        Background="{DynamicResource Brush.Control.Background}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" Cursor="Hand" AutomationProperties.AutomationId="ZE.Main.092.SaveSearchResultToMyPlacesCommand" AutomationProperties.Name="Save Search Result To My Places"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Expander>

                        </ScrollViewer>
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      Background="{DynamicResource Brush.Control.Border}"
                                      Cursor="SizeNS" ToolTip="Drag to resize Search and My Places"/>
                            <!-- ==================== SECTION 2: MY PLACES ==================== -->
                            <Expander Grid.Row="2" IsExpanded="{Binding IsMyPlacesExpanded, Mode=TwoWay}" Margin="0,0,0,8"
                                      Background="{DynamicResource Brush.Control.Background}"
                                      BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="📁 " FontSize="12"/>
                                        <TextBlock Text="My Places" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <TextBlock Text="[Persistent]" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Expander.Header>

                                <Border Background="{DynamicResource Brush.Window.Background}" Padding="6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Control.Border}">
                                    <Grid MinHeight="120">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Toolbar (Parity Framework - EXP-01) -->
                                        <Border Grid.Row="0" Background="{DynamicResource Brush.Control.Background}" CornerRadius="3" Padding="4,2" Margin="0,0,0,6">
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding AddPlacemarkCommand}" ToolTip="Add new Placemark (📍)" AutomationProperties.AutomationId="ZE.Main.093.AddPlacemarkCommand" AutomationProperties.Name="Add new Placemark (📍)">📍</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding DrawLineCommand}" ToolTip="Add Path/Line (〰️)" AutomationProperties.AutomationId="ZE.Main.094.DrawLineCommand" AutomationProperties.Name="Add Path/Line (〰️)">〰️</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding DrawPolygonCommand}" ToolTip="Add Polygon (⬡)" AutomationProperties.AutomationId="ZE.Main.095.DrawPolygonCommand" AutomationProperties.Name="Add Polygon (⬡)">⬡</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding DrawRectangleCommand}" ToolTip="Draw geographic rectangle by clicking two corners" AutomationProperties.AutomationId="ZE.Main.096.DrawRectangleCommand" AutomationProperties.Name="Draw geographic rectangle by clicking two corners">▭</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding AddFolderCommand}" ToolTip="Add new Folder (📁)" AutomationProperties.AutomationId="ZE.Main.097.AddFolderCommand" AutomationProperties.Name="Add new Folder (📁)">📁</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding AddSavedSceneCommand}" ToolTip="Save viewpoint as Scene (🎬)" AutomationProperties.AutomationId="ZE.Main.098.AddSavedSceneCommand" AutomationProperties.Name="Save viewpoint as Scene (🎬)">🎬</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding MoveSavedSceneUpCommand}" ToolTip="Move selected Saved Scene up. The first scene opens at startup." AutomationProperties.AutomationId="ZE.Main.099.MoveSavedSceneUpCommand" AutomationProperties.Name="Move selected Saved Scene up. The first scene opens at startup.">↑</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding MoveSavedSceneDownCommand}" ToolTip="Move selected Saved Scene down. The first scene opens at startup." AutomationProperties.AutomationId="ZE.Main.100.MoveSavedSceneDownCommand" AutomationProperties.Name="Move selected Saved Scene down. The first scene opens at startup.">↓</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ImportKmlCommand}" ToolTip="Import KML/KMZ (📥)" AutomationProperties.AutomationId="ZE.Main.101.ImportKmlCommand" AutomationProperties.Name="Import KML/KMZ (📥)">📥</Button>
                                                <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Control.Border}" Margin="4,0"/>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding SaveProjectCommand}" ToolTip="Save Active Project (💾)" AutomationProperties.AutomationId="ZE.Main.102.SaveProjectCommand" AutomationProperties.Name="Save Active Project (💾)">💾</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ExportSelectedItemCommand}" ToolTip="Export Selected Item to KML/KMZ (📤)" AutomationProperties.AutomationId="ZE.Main.103.ExportSelectedItemCommand" AutomationProperties.Name="Export Selected Item to KML/KMZ (📤)">📤</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding ExportAllMyPlacesCommand}" ToolTip="Export All My Places (📦)" AutomationProperties.AutomationId="ZE.Main.104.ExportAllMyPlacesCommand" AutomationProperties.Name="Export All My Places (📦)">📦</Button>
                                                <Button Style="{StaticResource QuickAccessBtnStyle}" Command="{Binding DeletePlaceCommand}" ToolTip="Delete Selected (🗑)" AutomationProperties.AutomationId="ZE.Main.105.DeletePlaceCommand" AutomationProperties.Name="Delete Selected (🗑)">🗑</Button>
                                            </WrapPanel>
                                        </Border>

                                        <!-- My Places TreeView (Saved Scenes is the first folder inside My Places) -->
                                        <TreeView Grid.Row="1" ItemsSource="{Binding MyPlaces}" MinHeight="120" VerticalAlignment="Stretch"
                                                  Background="{DynamicResource Brush.Window.Background}"
                                                  BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                                  MouseDoubleClick="TreeView_MouseDoubleClick"
                                                  PreviewMouseLeftButtonDown="TreeView_PreviewMouseLeftButtonDown"
                                                  PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown"
                                                  Padding="2">
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate DataType="{x:Type domain:PlaceItem}" ItemsSource="{Binding Children}">
                                                    <Grid Margin="1,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{Binding EffectiveColorHex}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                        <!-- In-row Fly To button -->
                                                        <Button Grid.Column="3" Content="✈" ToolTip="Fly To / Zoom to Extent"
                                                                Command="{Binding DataContext.FlyToPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Width="18" Height="18" Padding="0" FontSize="10" Margin="4,0,2,0"
                                                                Background="Transparent" Foreground="{DynamicResource Brush.Accent}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="ZE.Main.106.FlyToPlaceCommand" AutomationProperties.Name="Fly To / Zoom to Extent"/>
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>

                                            <!-- Context Menu on Nodes (Parity Framework - EXP-01..05) -->
                                            <TreeView.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="✈ Fly To / Zoom to Extent" Command="{Binding FlyToPlaceCommand}"/>
                                                    <MenuItem Header="⚙ Properties..." Command="{Binding OpenPropertiesCommand}"/>
                                                    <MenuItem Header="★ Set as Startup Scene" Command="{Binding SetAsStartupSceneCommand}"/>
                                                    <MenuItem Header="↑ Move Saved Scene Up" Command="{Binding MoveSavedSceneUpCommand}"/>
                                                    <MenuItem Header="↓ Move Saved Scene Down" Command="{Binding MoveSavedSceneDownCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="📍 Add Placemark" Command="{Binding AddPlacemarkCommand}"/>
                                                    <MenuItem Header="〰️ Add Path" Command="{Binding DrawLineCommand}"/>
                                                    <MenuItem Header="⬡ Add Polygon" Command="{Binding DrawPolygonCommand}"/>
                                                    <MenuItem Header="▭ Add Rectangle" Command="{Binding DrawRectangleCommand}"/>
                                                    <MenuItem Header="📁 Add Folder" Command="{Binding AddFolderCommand}"/>
                                                    <MenuItem Header="🎬 Add Saved Scene" Command="{Binding AddSavedSceneCommand}"/>
                                                    <MenuItem Header="📥 Import KML/KMZ..." Command="{Binding ImportKmlCommand}"/>
                                                    <MenuItem Header="GPS / GPX Import..." Command="{Binding ImportGpxCommand}"/>
                                                    <MenuItem Header="▶ Replay selected GPS track" Command="{Binding PlayGpsTrackCommand}"/>
                                                    <MenuItem Header="■ Stop GPS replay" Command="{Binding StopGpsTrackCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="💾 Save Active Project" Command="{Binding SaveProjectCommand}"/>
                                                    <MenuItem Header="📤 Export Selected Item..." Command="{Binding ExportSelectedItemCommand}"/>
                                                    <MenuItem Header="📦 Export All My Places..." Command="{Binding ExportAllMyPlacesCommand}"/>
                                                    <MenuItem Header="🗑 Delete" Command="{Binding DeletePlaceCommand}"/>
                                                </ContextMenu>
                                            </TreeView.ContextMenu>
                                        </TreeView>

                                    </Grid>
                                </Border>
                            </Expander>
                    </Grid>

                </Grid>
            </Border>

            <!-- ==================== COLUMN 1: RESIZABLE SPLITTER ==================== -->
            <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource Brush.Ribbon.Border}" Cursor="SizeWE"/>

            <!-- ==================== COLUMN 2: GEOGRAPHIC GLOBE VIEWPORT ==================== -->
            <Border x:Name="ViewportBorder" Grid.Column="2" Background="#000000">
                <wv2:WebView2 x:Name="GlobeWebView"/>
            </Border>

            <!-- Collapsed Sidebar Reveal Button (Right Edge) -->
            <Button x:Name="RevealSidebarRightBtn" Grid.Column="2" Command="{Binding ToggleSidebarCollapseCommand}"
                    Visibility="Collapsed" Width="26" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.Ribbon.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}"
                    BorderThickness="1,0,0,0" ToolTip="Expand Places &amp; Layers Sidebar (Ctrl+B)" Cursor="Hand" AutomationProperties.AutomationId="ZE.Main.107.ToggleSidebarCollapseCommand" AutomationProperties.Name="Expand Places &amp; Layers Sidebar (Ctrl+B)">
                <Path Data="{StaticResource Icon.PrevExtent}" Style="{StaticResource RibbonSmallIconStyle}" Fill="{DynamicResource Brush.Accent}"/>
            </Button>
        </Grid>

        <!-- Real, nonblocking, auto-dismissing notifications on the status row.
             Unlike a WPF overlay over WebView2, this is never hidden by HWND airspace. -->
        <Border Grid.Row="3" Panel.ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="14,0" Padding="14,8" CornerRadius="7" MaxWidth="320"
                Background="{DynamicResource Brush.Ribbon.Background}"
                BorderBrush="{DynamicResource Brush.Ribbon.Border}" BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- ==================== ROW 3: TWO-ROW STATUS BAR (P0 - CRS-01..08) ==================== -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.StatusBar.Background}"
                BorderBrush="{DynamicResource Brush.StatusBar.Border}" BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Upper Row: Center Coordinates | Eye Altitude | Heading | CRS / View Mode -->
                <Grid Grid.Row="0" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding ToggleCoordinateFormatCommand}" Style="{StaticResource StatusBarBtnStyle}"
                            ToolTip="Map Center: ground target under screen center. Click to cycle coordinate format (DD, DMS, UTM, MGRS)" AutomationProperties.AutomationId="ZE.Main.108.ToggleCoordinateFormatCommand" AutomationProperties.Name="Map Center: ground target under screen center. Click to cycle coordinate format (DD, DMS, UTM, MGRS)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎯 " FontSize="11" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="{Binding StatusCenterCoordinates}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text=" | Eye: " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding StatusAltitude}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text=" | Head: " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding StatusHeading}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding SelectCrsCommand}" Style="{StaticResource StatusBarBtnStyle}"
                                ToolTip="Click to select Coordinate Reference System (CRS)" AutomationProperties.AutomationId="ZE.Main.109.SelectCrsCommand" AutomationProperties.Name="Click to select Coordinate Reference System (CRS)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CRS: " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                <TextBlock Text="{Binding StatusCrs}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Accent}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="4,0"/>
                        <TextBlock Text="{Binding StatusViewMode}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Lower Row: Live Cursor Tracking | Status | Developer Attribution -->
                <Grid Grid.Row="1" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👆 " FontSize="11" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="{Binding StatusCursorCoordinates}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,8,0"/>
                        <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusCursorElevation}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" ⟳" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   ToolTip="Working…"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Developed by " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBlock Text="Ahmad Ibrahim" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Accent}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
