<Window x:Class="ZEarth.App.Views.CrsSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map Coordinate Reference System (CRS) Browser"
        Height="640" Width="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Ribbon.Background}" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                BorderBrush="{DynamicResource Brush.Ribbon.Border}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.CrsGlobe}" Style="{StaticResource RibbonIconPathStyle}" Width="24" Height="24" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Map Coordinate Reference System (CRS) Browser" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="Select a Geographic or Projected Coordinate System for 2D map reprojection, layer alignment, and coordinate readouts."
                               FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding CatalogStatus}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Height="30" Padding="8,4" VerticalContentAlignment="Center"
                     Background="{DynamicResource Brush.Control.Background}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Control.Border}"
                     BorderThickness="1"
                     ToolTip="Search by EPSG code (e.g. 22992, 32636, 4326), name (e.g. Red Belt, UTM), country (Egypt), or datum..."/>
        </Grid>

        <!-- Split View: Catalog Tree / Search Results & Details Pane -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Catalog Tree (when not searching) or Search Results (when searching) -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}"
                    BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <!-- Hierarchical TreeView -->
                    <TreeView x:Name="CrsTreeView"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="OnTreeViewSelectedItemChanged"
                              Background="Transparent"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              BorderThickness="0"
                              Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Flat Search Results List (Shown when searching) -->
                    <ListView ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedCrs}"
                              Background="Transparent"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              BorderThickness="0"
                              Visibility="{Binding IsSearchResultsVisible, Converter={StaticResource BoolToVis}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Code" DisplayMemberBinding="{Binding AuthorityCode}" Width="90"/>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="210"/>
                                <GridViewColumn Header="Area of Use" DisplayMemberBinding="{Binding AreaOfUse}" Width="150"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Details Pane & Favorite Button -->
            <Border Grid.Column="1" Margin="10,0,0,0" Padding="12"
                    Background="{DynamicResource Brush.Control.Background}"
                    BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Favorite Star Button -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Command="{Binding ToggleFavoriteCommand}"
                                Height="26" Padding="10,2" FontSize="11"
                                Background="{DynamicResource Brush.Window.Background}"
                                Foreground="{DynamicResource Brush.Accent}"
                                BorderBrush="{DynamicResource Brush.Control.Border}"
                                ToolTip="Add or remove this CRS from your persistent Favorites list">
                            <TextBlock Text="{Binding FavoriteButtonText}" FontWeight="SemiBold"/>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="CRS Properties &amp; Metadata" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Details Text -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding SelectedCrsDetails, Mode=OneWay}" TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                                 Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Dialog Action Buttons -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="2D Map default: WGS 84 (EPSG:4326)" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Apply Map CRS" Width="120" Height="30" Margin="0,0,8,0"
                        IsEnabled="{Binding CanApply}"
                        Click="OnApplyClick"
                        Background="{DynamicResource Brush.Accent}" Foreground="#FFFFFF" FontWeight="SemiBold"
                        ToolTip="Apply selected Coordinate System to the active 2D Map"/>
                <Button Content="Cancel" Width="85" Height="30" IsCancel="True"
                        Background="{DynamicResource Brush.Control.Background}" Foreground="{DynamicResource Brush.Text.Primary}"
                        BorderBrush="{DynamicResource Brush.Control.Border}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
