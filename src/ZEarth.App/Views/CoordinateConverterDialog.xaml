<Window x:Class="ZEarth.App.Views.CoordinateConverterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coordinate System Converter"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Window.Background}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Ribbon.Background}" CornerRadius="6" Padding="12" Margin="0,0,0,14"
                BorderBrush="{StaticResource Brush.Ribbon.Border}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.CoordConverter}" Style="{StaticResource RibbonIconPathStyle}" Width="22" Height="22" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Bidirectional Coordinate Converter" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="Convert seamlessly between DD, DMS, UTM, and MGRS on WGS 84 ellipsoid." FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Conversion Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Decimal Degrees (DD) -->
                <GroupBox Header="Decimal Degrees (DD — WGS 84)" Margin="0,0,0,10" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold"
                          BorderBrush="{StaticResource Brush.Ribbon.Border}">
                    <Grid Margin="8" TextElement.FontWeight="Normal">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Latitude (-90° to +90°):" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="DdLatText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" TextChanged="OnDdChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Longitude (-180° to +180°):" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="DdLonText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" TextChanged="OnDdChanged"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Degrees Minutes Seconds (DMS) -->
                <GroupBox Header="Degrees Minutes Seconds (DMS)" Margin="0,0,0,10" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold"
                          BorderBrush="{StaticResource Brush.Ribbon.Border}">
                    <Grid Margin="8" TextElement.FontWeight="Normal">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Latitude (e.g. 30° 02' 39.8&quot; N):" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="DmsLatText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Longitude (e.g. 31° 14' 08.5&quot; E):" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="DmsLonText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Universal Transverse Mercator (UTM) -->
                <GroupBox Header="Universal Transverse Mercator (UTM)" Margin="0,0,0,10" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold"
                          BorderBrush="{StaticResource Brush.Ribbon.Border}">
                    <Grid Margin="8" TextElement.FontWeight="Normal">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Zone:" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="UtmZoneText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Easting (m):" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="UtmEastingText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Northing (m):" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="UtmNorthingText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Military Grid Reference System (MGRS) -->
                <GroupBox Header="Military Grid Reference System (MGRS)" Margin="0,0,0,10" Foreground="{StaticResource Brush.Accent}" FontWeight="Bold"
                          BorderBrush="{StaticResource Brush.Ribbon.Border}">
                    <Grid Margin="8" TextElement.FontWeight="Normal">
                        <StackPanel>
                            <TextBlock Text="Standard MGRS Coordinate String:" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBox x:Name="MgrsText" Height="26" VerticalContentAlignment="Center" Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Copy All" Width="85" Height="28" Click="OnCopyAllClick"
                    Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}"
                    BorderBrush="{StaticResource Brush.Control.Border}" BorderThickness="1"/>

            <Button DockPanel.Dock="Right" Content="Close" Width="80" Height="28" IsCancel="True" Margin="8,0,0,0"
                    Background="{StaticResource Brush.Control.Background}" Foreground="{StaticResource Brush.Text.Primary}"
                    BorderBrush="{StaticResource Brush.Control.Border}" BorderThickness="1"/>

            <Button DockPanel.Dock="Right" Content="Fly To Position" Width="110" Height="28" Click="OnFlyToClick"
                    Background="{StaticResource Brush.Accent}" Foreground="#ffffff" BorderThickness="0" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>
