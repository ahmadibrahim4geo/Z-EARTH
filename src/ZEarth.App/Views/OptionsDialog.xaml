<Window x:Class="ZEarth.App.Views.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZEarth.App.Views"
        Title="Options &amp; GIS Settings"
        Height="760" Width="1180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        Loaded="OnOptionsDialogLoaded"
        Closing="OnOptionsDialogClosing"
        AutomationProperties.AutomationId="ZE.Options.Window"
        AutomationProperties.Name="Z EARTH Options and GIS Settings">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Original, provider-neutral illustrative previews. These are UI thumbnails, not cached provider tiles. -->
        <ImageBrush x:Key="BasemapThumbSatellite" ImageSource="pack://application:,,,/Assets/Options/basemap-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="BasemapThumbHybrid" ImageSource="pack://application:,,,/Assets/Options/basemap-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.338,0,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="BasemapThumbStreet" ImageSource="pack://application:,,,/Assets/Options/basemap-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.675,0,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="BasemapThumbTopo" ImageSource="pack://application:,,,/Assets/Options/basemap-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0.338,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="BasemapThumbLight" ImageSource="pack://application:,,,/Assets/Options/basemap-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.338,0.338,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="BasemapThumbDark" ImageSource="pack://application:,,,/Assets/Options/basemap-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.675,0.338,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="BasemapThumbPhysical" ImageSource="pack://application:,,,/Assets/Options/basemap-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0.675,0.325,0.325" Stretch="UniformToFill"/>

        <ImageBrush x:Key="TerrainThumbDem" ImageSource="pack://application:,,,/Assets/Options/terrain-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="TerrainThumbWorld" ImageSource="pack://application:,,,/Assets/Options/terrain-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.338,0,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="TerrainThumbBathymetry" ImageSource="pack://application:,,,/Assets/Options/terrain-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.675,0,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="TerrainThumbGebco" ImageSource="pack://application:,,,/Assets/Options/terrain-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0.338,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="TerrainThumbEllipsoid" ImageSource="pack://application:,,,/Assets/Options/terrain-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.338,0.338,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="TerrainThumbLocal" ImageSource="pack://application:,,,/Assets/Options/terrain-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.675,0.338,0.325,0.325" Stretch="UniformToFill"/>
        <ImageBrush x:Key="TerrainThumbCustom" ImageSource="pack://application:,,,/Assets/Options/terrain-thumbnail-atlas.png" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0.675,0.325,0.325" Stretch="UniformToFill"/>

        <Style x:Key="BasemapThumbnailFrameStyle" TargetType="Border">
            <Setter Property="Width" Value="66"/><Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="6"/><Setter Property="BorderBrush" Value="#668496A3"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="TerrainThumbnailFrameStyle" TargetType="Border">
            <Setter Property="Width" Value="54"/><Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="6"/><Setter Property="BorderBrush" Value="#668496A3"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#202932"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ribbon.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <Style x:Key="SettingsComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
        </Style>
        <Style x:Key="GalleryListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
        </Style>
        <Style x:Key="GalleryItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="#202932"/>
            <Setter Property="BorderBrush" Value="#3B4650"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="RadioRing" Width="20" Height="20" CornerRadius="10"
                                        BorderBrush="#D8E2EA" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Ellipse x:Name="RadioDot" Width="10" Height="10" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#173F58"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="RadioRing" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#253641"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="48" Height="26" CornerRadius="13" Background="#4A5560" Margin="0,0,10,0">
                                <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TargetRowStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="InfoPanelStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
            <Setter Property="Background" Value="#102E3E"/>
            <Setter Property="BorderBrush" Value="#1879A6"/>
        </Style>
        <Style x:Key="GridFormatRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#1B252E" BorderBrush="#46525C" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#173F58"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#253641"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ribbon.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Margin="0,0,3,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#193C50"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#263642"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,12,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Ribbon.Background}" CornerRadius="10" Padding="20,14" Margin="0,0,0,10"
                BorderBrush="{DynamicResource Brush.Ribbon.Border}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="#223C4A" Margin="0,0,16,0">
                    <Path Data="{StaticResource Icon.Options}" Style="{StaticResource RibbonIconPathStyle}" Width="26" Height="26"
                          Fill="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Z EARTH Options &amp; GIS Configuration" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="Configure measurement units, spatial snapping, basemaps, terrain, grid, and display preferences."
                               FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabbed Settings Content -->
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="{DynamicResource Brush.Ribbon.Background}"
                    BorderBrush="{DynamicResource Brush.Ribbon.Border}" BorderThickness="1" Padding="0"
                    AutomationProperties.AutomationId="ZE.Options.Tabs">
            
            <!-- Tab 1: Measurement Units -->
            <TabItem Header="Measurement Units" AutomationProperties.AutomationId="ZE.Options.Tab.Units">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="18,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="⌁" FontSize="38" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Measurement Units" Style="{StaticResource SectionTitleStyle}" FontSize="19"/>
                                    <TextBlock Text="Choose the units used for distance, area, and elevation display. Calculation values remain in canonical SI units internally."
                                               Style="{StaticResource HintTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}" MinHeight="320">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#12364A"><TextBlock Text="↔" FontSize="26" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Distance" Style="{StaticResource SectionTitleStyle}" FontSize="17"/><TextBlock Text="Horizontal distances, paths, ruler results and navigation readouts." Style="{StaticResource HintTextStyle}"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Distance unit" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="DistanceUnitCombo" Style="{StaticResource SettingsComboStyle}" SelectionChanged="OnUnitSelectionChanged" AutomationProperties.Name="Geodesic distance units">
                                        <ComboBoxItem Content="Auto Metric (m / km)" Tag="AutoMetric"/><ComboBoxItem Content="Meters (m)" Tag="Meters"/><ComboBoxItem Content="Kilometers (km)" Tag="Kilometers"/>
                                        <ComboBoxItem Content="Centimeters (cm)" Tag="Centimeters"/><ComboBoxItem Content="Millimeters (mm)" Tag="Millimeters"/>
                                        <ComboBoxItem Content="Auto Imperial (ft / mi)" Tag="AutoImperial"/><ComboBoxItem Content="Feet (ft)" Tag="Feet"/><ComboBoxItem Content="Inches (in)" Tag="Inches"/>
                                        <ComboBoxItem Content="Yards (yd)" Tag="Yards"/><ComboBoxItem Content="Miles (mi)" Tag="Miles"/><ComboBoxItem Content="Nautical Miles (nmi)" Tag="NauticalMiles"/>
                                    </ComboBox>
                                    <Border Style="{StaticResource InfoPanelStyle}" Padding="14" Margin="0,16,0,0">
                                        <StackPanel><TextBlock Text="Example" Foreground="#61C4F2" FontWeight="SemiBold"/><TextBlock Text="A distance of 1,234.56 metres is displayed as:" Style="{StaticResource HintTextStyle}" Margin="0,8,0,4"/><TextBlock x:Name="DistancePreviewText" Text="1.235 km (1234.6 m)" FontSize="19" FontWeight="Bold" Foreground="#61C4F2"/></StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" MinHeight="320">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#123D35"><TextBlock Text="⬡" FontSize="24" Foreground="#44D477" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Area" Style="{StaticResource SectionTitleStyle}" FontSize="17"/><TextBlock Text="Polygon measurements, regions, coverage and saved area results." Style="{StaticResource HintTextStyle}"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Area unit" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="AreaUnitCombo" Style="{StaticResource SettingsComboStyle}" SelectionChanged="OnUnitSelectionChanged" AutomationProperties.Name="Surface area units">
                                        <ComboBoxItem Content="Auto Metric (m² / ha / km²)" Tag="AutoMetric"/><ComboBoxItem Content="Square metres (m²)" Tag="SquareMeters"/><ComboBoxItem Content="Square kilometres (km²)" Tag="SquareKilometers"/>
                                        <ComboBoxItem Content="Hectares (ha)" Tag="Hectares"/><ComboBoxItem Content="Egyptian feddan (4,200.8335 m²)" Tag="EgyptianFeddan"/><ComboBoxItem Content="Square centimetres (cm²)" Tag="SquareCentimeters"/>
                                        <ComboBoxItem Content="Square millimetres (mm²)" Tag="SquareMillimeters"/><ComboBoxItem Content="Auto Imperial (ft² / ac / mi²)" Tag="AutoImperial"/><ComboBoxItem Content="Square feet (ft²)" Tag="SquareFeet"/>
                                        <ComboBoxItem Content="Square inches (in²)" Tag="SquareInches"/><ComboBoxItem Content="Square yards (yd²)" Tag="SquareYards"/><ComboBoxItem Content="Acres (ac)" Tag="Acres"/><ComboBoxItem Content="Square miles (mi²)" Tag="SquareMiles"/>
                                    </ComboBox>
                                    <Border Style="{StaticResource InfoPanelStyle}" Padding="14" Margin="0,16,0,0">
                                        <StackPanel><TextBlock Text="Example" Foreground="#61C4F2" FontWeight="SemiBold"/><TextBlock Text="An area of 1,250,000 square metres is displayed as:" Style="{StaticResource HintTextStyle}" Margin="0,8,0,4"/><TextBlock x:Name="AreaPreviewText" Text="1.250 km² (125.0 ha)" FontSize="19" FontWeight="Bold" Foreground="#61C4F2"/></StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource SettingsCardStyle}" MinHeight="320">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="24" Background="#12364A"><TextBlock Text="▲" FontSize="23" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Elevation" Style="{StaticResource SectionTitleStyle}" FontSize="17"/><TextBlock Text="Terrain samples, profiles, placemark altitude and eye height." Style="{StaticResource HintTextStyle}"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Elevation unit" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="ElevationUnitCombo" Style="{StaticResource SettingsComboStyle}" SelectionChanged="OnUnitSelectionChanged" AutomationProperties.Name="Elevation units">
                                        <ComboBoxItem Content="Metres (m)" Tag="Meters"/><ComboBoxItem Content="Kilometres (km)" Tag="Kilometers"/><ComboBoxItem Content="Centimetres (cm)" Tag="Centimeters"/>
                                        <ComboBoxItem Content="Millimetres (mm)" Tag="Millimeters"/><ComboBoxItem Content="Feet (ft)" Tag="Feet"/><ComboBoxItem Content="Inches (in)" Tag="Inches"/>
                                    </ComboBox>
                                    <Border Style="{StaticResource InfoPanelStyle}" Padding="14" Margin="0,16,0,0">
                                        <StackPanel><TextBlock Text="Example" Foreground="#61C4F2" FontWeight="SemiBold"/><TextBlock Text="An elevation of 987.65 metres is displayed as:" Style="{StaticResource HintTextStyle}" Margin="0,8,0,4"/><TextBlock x:Name="ElevationPreviewText" Text="987.7 m" FontSize="19" FontWeight="Bold" Foreground="#61C4F2"/></StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource InfoPanelStyle}" Margin="0,14,0,0" Padding="18">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Brush.Accent}"><TextBlock Text="i" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock Text="About Measurement Units" Style="{StaticResource SectionTitleStyle}" FontSize="16"/><TextBlock Text="Z EARTH stores length and elevation in metres and area in square metres; geodesic measurements use WGS 84. Unit choices affect display and supported export formatting only—they never redefine the map CRS or modify stored geometry." Style="{StaticResource HintTextStyle}" FontSize="11.5"/></StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Spatial Snapping -->
            <TabItem Header="Spatial Snapping" AutomationProperties.AutomationId="ZE.Options.Tab.Snapping">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Grid Margin="4,0,4,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌖" FontSize="40" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Spatial Snapping" Style="{StaticResource SectionTitleStyle}" FontSize="19"/>
                                <TextBlock Text="Control how Z EARTH snaps to geographic features when drawing and measuring." Style="{StaticResource HintTextStyle}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"><CheckBox x:Name="SnapEnabledCheck" Content="Enable snapping" IsChecked="True" Style="{StaticResource SwitchCheckBoxStyle}"
                                      FontWeight="SemiBold" FontSize="14" AutomationProperties.AutomationId="ZE.Options.Snapping.Enabled"/>
                                <TextBlock Text="Snap to features while drawing and measuring." Style="{StaticResource HintTextStyle}" Margin="58,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}" MinHeight="400">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
