                                        <ListBoxItem Tag="ellipsoid"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Style="{StaticResource TerrainThumbnailFrameStyle}" Background="{StaticResource TerrainThumbEllipsoid}"/><StackPanel Grid.Column="1"><TextBlock Text="WGS84 Ellipsoid" FontWeight="Bold"/><TextBlock Text="Smooth globe; no elevation" Style="{StaticResource HintTextStyle}"/></StackPanel><TextBlock Grid.Column="2" Text="Offline" Foreground="#D6D9DC" HorizontalAlignment="Right"/></Grid></ListBoxItem>
                                        <ListBoxItem Tag="localDem"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Style="{StaticResource TerrainThumbnailFrameStyle}" Background="{StaticResource TerrainThumbLocal}"/><StackPanel Grid.Column="1"><TextBlock Text="Local DEM / Bathymetry" FontWeight="Bold"/><TextBlock Text="GeoTIFF/IMG/DEM numeric raster" Style="{StaticResource HintTextStyle}"/></StackPanel><TextBlock Grid.Column="2" Text="Local" Foreground="#61C4F2" HorizontalAlignment="Right"/></Grid></ListBoxItem>
                                        <ListBoxItem Tag="custom"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Style="{StaticResource TerrainThumbnailFrameStyle}" Background="{StaticResource TerrainThumbCustom}"/><StackPanel Grid.Column="1"><TextBlock Text="Custom Quantized-Mesh Service" FontWeight="Bold"/><TextBlock Text="Authorized HTTPS terrain endpoint" Style="{StaticResource HintTextStyle}"/></StackPanel><TextBlock Grid.Column="2" Text="Online" Foreground="#61C4F2" HorizontalAlignment="Right"/></Grid></ListBoxItem>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Source Configuration" Style="{StaticResource SectionTitleStyle}"/>
                                    <Border Background="#17364A" BorderBrush="#2D739A" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,8,0,12"><StackPanel><TextBlock x:Name="TerrainSourceTitle" Text="AWS Terrarium DEM" FontWeight="Bold" FontSize="15"/><TextBlock x:Name="TerrainSourceSummary" Text="Global numeric land elevation from AWS Open Data." Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <TextBlock x:Name="TerrainRequirementsText" Text="No credentials are required for AWS Terrarium DEM."
                                               Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>

                                    <StackPanel x:Name="IonConfigurationPanel">
                                        <TextBlock Text="Cesium ion access token" Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid Margin="0,0,0,7"><PasswordBox x:Name="CesiumIonTokenBox" Height="38" Padding="8,5" Background="{DynamicResource Brush.Control.Background}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Control.Border}" PasswordChanged="OnCesiumTokenPasswordChanged" AutomationProperties.Name="Cesium ion access token"/><TextBox x:Name="CesiumIonTokenVisibleBox" Style="{StaticResource SettingsInputStyle}" Visibility="Collapsed" TextChanged="OnCesiumTokenVisibleChanged"/><Button Content="👁" HorizontalAlignment="Right" Width="42" Margin="0,1,1,1" Style="{StaticResource SecondaryButtonStyle}" Click="OnToggleTokenVisibilityClick" AutomationProperties.Name="Show or hide Cesium ion token"/></Grid>
                                        <Grid x:Name="TerrainAssetIdPanel" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="Asset access is validated by the Cesium engine." Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="2426648" IsReadOnly="True" Style="{StaticResource SettingsInputStyle}" AutomationProperties.Name="Cesium World Bathymetry asset id"/></Grid>
                                        <TextBlock Text="The token is kept in process memory only and is excluded from settings.json and logs. Managed deployments may use ZEARTH_CESIUM_ION_TOKEN." Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>
                                    </StackPanel>

                                    <StackPanel x:Name="CustomTerrainPanel">
                                        <TextBlock Text="Custom quantized-mesh service URL" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="CustomTerrainUrlBox" Style="{StaticResource SettingsInputStyle}" Margin="0,0,0,5"
                                                 ToolTip="HTTPS URL whose root exposes layer.json and quantized-mesh tiles"/>
                                        <TextBlock Text="The HTTPS service root must expose layer.json and Cesium quantized-mesh tiles. Arbitrary file and private-network URLs are rejected."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>
                                    </StackPanel>

                                    <StackPanel x:Name="CopernicusApiPanel" Visibility="Collapsed">
                                        <TextBlock Text="Copernicus Data Space OAuth access token" Style="{StaticResource FieldLabelStyle}"/>
                                        <PasswordBox x:Name="CopernicusAccessTokenBox" Height="38" Padding="8,5" Margin="0,0,0,6" Background="{DynamicResource Brush.Control.Background}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Control.Border}" AutomationProperties.Name="Copernicus Data Space access token"/>
                                        <TextBlock Text="GLO-30 is free after CDSE/CCM registration, but its official Process API is authenticated. This token is kept in memory only and is never written to settings.json." Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"/>
                                    </StackPanel>

                                    <StackPanel x:Name="LocalTerrainPanel" Visibility="Collapsed">
                                        <Button Content="Browse Numeric Elevation Raster…" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="OnBrowseLocalDemClick" AutomationProperties.Name="Choose local numeric elevation raster"/>
                                        <TextBlock Text="Stored vertical unit" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="LocalTerrainVerticalUnitCombo" Style="{StaticResource SettingsComboStyle}" Margin="0,0,0,8"><ComboBoxItem Content="Metres" Tag="Meters"/><ComboBoxItem Content="Feet (converted to metres)" Tag="Feet"/></ComboBox>
                                        <TextBlock x:Name="LocalDemMetadataText" Text="Select a georeferenced numeric raster. GDAL validates its CRS, transform, band and NoData before Z EARTH can render it." Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"/>
                                        <Button x:Name="GebcoGuideButton" Content="Open official GEBCO guidance ↗" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,12" Click="OnOpenGebcoGuidanceClick"/>
                                    </StackPanel>

                                    <Grid Margin="0,2,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Content="Test Connection" Style="{StaticResource PrimaryButtonStyle}" Click="OnTestTerrainConnectionClick"
                                                AutomationProperties.AutomationId="ZE.Options.Terrain.Test"/>
                                        <Button Grid.Column="2" x:Name="GetCesiumIonTokenButton" Content="Get Cesium ion Token ↗" Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OnOpenCesiumIonClick"/>
                                    </Grid>
                                    <TextBlock x:Name="TerrainTestResultText" Text="A connection test uses the embedded Cesium engine and may temporarily apply the selected source to the current globe."
                                               Style="{StaticResource HintTextStyle}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="4">
                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Source Help" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock x:Name="TerrainHelpTitle" Text="AWS Terrarium DEM" FontWeight="Bold" Foreground="#65BCEB" Margin="0,8,0,4"/>
                                        <TextBlock x:Name="TerrainHelpText"
                                                   Text="A free public heightmap source hosted through AWS Open Data. It supplies numeric land elevation to Cesium; coverage and source quality vary by region."
                                                   Style="{StaticResource HintTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="GIS Source Truth" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="• Terrain tiles contain numeric heights and can shape the globe." Style="{StaticResource HintTextStyle}" Margin="0,5,0,2"/>
                                        <TextBlock Text="• WMS and shaded-relief images are 2D imagery, not elevation." Style="{StaticResource HintTextStyle}" Margin="0,2"/>
                                        <TextBlock Text="• A raw DEM/GeoTIFF needs tiling or conversion before Cesium can render it as terrain." Style="{StaticResource HintTextStyle}" Margin="0,2"/>
                                        <TextBlock Text="• GEBCO 2026 is a dataset, not a ready TerrainServer endpoint." Style="{StaticResource HintTextStyle}" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,14,0,0" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⚙" FontSize="30" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Default Elevation Model" Style="{StaticResource SectionTitleStyle}" FontSize="15"/><TextBlock Text="The selected source is saved as the preferred provider. Saving does not turn Terrain on; the ribbon owns OFF, loading, success, and error state." Style="{StaticResource HintTextStyle}"/></StackPanel><TextBlock x:Name="DefaultTerrainSummary" Grid.Column="2" Text="AWS Terrarium DEM" FontWeight="SemiBold" Foreground="#61C4F2" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Dedicated grid configuration: deliberately isolated from basemap settings. -->
            <TabItem Header="Map Grid" AutomationProperties.AutomationId="ZE.Options.Tab.Grid">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- Grid identity + single authoritative ON/OFF state -->
                        <Border Background="{DynamicResource Brush.Sidebar.Background}"
                                BorderBrush="{DynamicResource Brush.Ribbon.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource Icon.CrsGlobe}" Stretch="Uniform"
                                      Width="26" Height="26" Fill="{DynamicResource Brush.Accent}"
                                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Geographic Coordinate Grid" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Geographic reference lines, grid lines, coordinate labels and UTM zone boundaries."
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="ResetGridDefaultsButton" Grid.Column="2" Content="Reset to defaults"
                                        Height="26" Padding="10,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Click="OnResetGridDefaultsClick"
                                        Background="{DynamicResource Brush.Control.Background}"
                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                        BorderBrush="{DynamicResource Brush.Control.Border}" BorderThickness="1"
                                        ToolTip="Restore the documented Map Grid defaults. Nothing is saved until Save Settings."/>
                                <Border x:Name="GridStatePill" Grid.Column="3" CornerRadius="14" Padding="12,5"
                                        Background="#22303A" BorderBrush="{DynamicResource Brush.Control.Border}"
                                        BorderThickness="1" VerticalAlignment="Center"
                                        ToolTip="Controlled by View → Show Grid">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="GridStateDot" Width="8" Height="8" Fill="#9CA3AF"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GridStateText" Text="Grid OFF" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Visibility and independent colours -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="318"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,0"
                                    Background="{DynamicResource Brush.Sidebar.Background}"
                                    BorderBrush="{DynamicResource Brush.Ribbon.Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Grid Visibility" FontWeight="Bold" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="KeyParallelsCheck"
                                              Content="Major Geographic Reference Lines &amp; Points"
                                              IsChecked="True" FontWeight="SemiBold"
                                              Style="{StaticResource SwitchCheckBoxStyle}"
                                              Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Equator, Tropics, Polar Circles, Greenwich, Date Line, both Poles and Grid Origin 0°, 0°."
                                               TextWrapping="Wrap" FontSize="10.5" Margin="22,2,0,8"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <CheckBox x:Name="LongitudeLinesCheck" Content="Show longitude lines (meridians)"
                                              Style="{StaticResource SwitchCheckBoxStyle}"
                                              Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <CheckBox x:Name="LatitudeLinesCheck" Content="Show latitude lines (parallels)"
                                              Style="{StaticResource SwitchCheckBoxStyle}"
                                              Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Labels are generated automatically for every enabled component. View → Show Grid overrides all of them."
                                               TextWrapping="Wrap" FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource Brush.Sidebar.Background}"
                                    BorderBrush="{DynamicResource Brush.Ribbon.Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Grid Colors" FontWeight="Bold" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Major reference lines &amp; points" VerticalAlignment="Center"
                                                   FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <views:ColorPickerButton x:Name="MajorColorPicker" Grid.Column="1" ColorHex="#FF5252"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Longitude lines (meridians)" VerticalAlignment="Center"
                                                   FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <views:ColorPickerButton x:Name="LongitudeColorPicker" Grid.Column="1" ColorHex="#3BA9FF"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Latitude lines (parallels)" VerticalAlignment="Center"
                                                   FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <views:ColorPickerButton x:Name="LatitudeColorPicker" Grid.Column="1" ColorHex="#3AD17B"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Coordinate labels" VerticalAlignment="Center"
                                                   FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <views:ColorPickerButton x:Name="LabelColorPicker" Grid.Column="1" ColorHex="#E8E8E8"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="UTM zone boundaries" VerticalAlignment="Center"
                                                   FontSize="11.5" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <views:ColorPickerButton x:Name="UtmColorPicker" Grid.Column="1" ColorHex="#FFC107"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Label format, size and independent intervals -->
                        <Border Background="{DynamicResource Brush.Sidebar.Background}"
                                BorderBrush="{DynamicResource Brush.Ribbon.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Label Format &amp; Appearance" FontWeight="Bold" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Coordinate format" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="GridFormatDdRadio" GroupName="GridFormat" Tag="DD" Style="{StaticResource GridFormatRadioStyle}" IsChecked="True" Checked="OnGridFormatChecked"><StackPanel><TextBlock Text="Decimal Degrees" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="−122.4194°" Style="{StaticResource HintTextStyle}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                            <RadioButton x:Name="GridFormatDmRadio" Grid.Column="1" GroupName="GridFormat" Tag="DM" Style="{StaticResource GridFormatRadioStyle}" Checked="OnGridFormatChecked"><StackPanel><TextBlock Text="Degrees Minutes" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="122° 25.164′" Style="{StaticResource HintTextStyle}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                            <RadioButton x:Name="GridFormatDmsRadio" Grid.Column="2" GroupName="GridFormat" Tag="DMS" Style="{StaticResource GridFormatRadioStyle}" Checked="OnGridFormatChecked"><StackPanel><TextBlock Text="DMS" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="122° 25′ 9.8″" Style="{StaticResource HintTextStyle}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                            <RadioButton x:Name="GridFormatDegreesRadio" Grid.Column="3" GroupName="GridFormat" Tag="Degrees" Style="{StaticResource GridFormatRadioStyle}" Checked="OnGridFormatChecked"><StackPanel><TextBlock Text="Whole Degrees" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="122°" Style="{StaticResource HintTextStyle}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></RadioButton>
                                        </Grid>
                                        <ComboBox x:Name="GridLabelFormatCombo" Visibility="Collapsed"><ComboBoxItem Content="Decimal degrees" Tag="DD"/><ComboBoxItem Content="Whole degrees" Tag="Degrees"/><ComboBoxItem Content="Degrees minutes" Tag="DM"/><ComboBoxItem Content="DMS" Tag="DMS"/></ComboBox>
                                        <TextBlock Text="Trailing zeros are trimmed; whole coordinates stay clean (10°, not 10.000°)." Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="Label size" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,7"/>
                                        <Slider x:Name="GridLabelSizeSlider" Minimum="0" Maximum="3"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="2"
                                                VerticalAlignment="Center" ValueChanged="OnGridLabelSizeChanged"/>
                                        <Grid Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SizeSmallText" Text="Small" FontSize="10" TextAlignment="Left"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                            <TextBlock x:Name="SizeMediumText" Grid.Column="1" Text="Medium" FontSize="10" TextAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                            <TextBlock x:Name="SizeLargeText" Grid.Column="2" Text="Large" FontSize="10" TextAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SizeExtraLargeText" Grid.Column="3" Text="Extra Large" FontSize="10" TextAlignment="Right"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Longitude interval (0 = auto)" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="LongitudeIntervalInput" Height="26" MaxLength="6"
                                                 ToolTip="Enter 0 (auto) or a numeric interval from 0.05° to 60°"
                                                 Background="{DynamicResource Brush.Control.Background}"
                                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                                 BorderBrush="{DynamicResource Brush.Control.Border}"
                                                 Margin="0,0,0,6"/>
                                        <TextBlock Text="Latitude interval (0 = auto)" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="LatitudeIntervalInput" Height="26" MaxLength="6"
                                                 ToolTip="Enter 0 (auto) or a numeric interval from 0.05° to 60°"
                                                 Background="{DynamicResource Brush.Control.Background}"
                                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                                 BorderBrush="{DynamicResource Brush.Control.Border}"/>
                                        <TextBlock Text="Use 0 for automatic spacing at every zoom level. A fixed interval may be outside the current view."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- UTM zones -->
                        <Border Background="{DynamicResource Brush.Sidebar.Background}"
                                BorderBrush="{DynamicResource Brush.Ribbon.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                ToolTip="UTM zone labels are centered inside each 6° zone, never drawn on the boundary line.">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="UTM Zone Boundaries &amp; Labels" FontWeight="Bold" FontSize="12.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <CheckBox x:Name="UtmZonesCheck" Grid.Column="1" Content="Show UTM zone boundaries &amp; labels"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource SwitchCheckBoxStyle}"
                                              Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Boundary color" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>
                                        <views:ColorPickerButton x:Name="UtmBoundaryColorPicker" ColorHex="#FFC107"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="Label placement" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="UtmLabelPlacementCombo" Style="{StaticResource SettingsComboStyle}">
                                            <ComboBoxItem Content="Center of each zone" Tag="Center"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Label type" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="UtmLabelModeCombo" Style="{StaticResource SettingsComboStyle}">
                                            <ComboBoxItem Content="Grid zone designation (e.g. 36R)" Tag="GridZone"/>
                                            <ComboBoxItem Content="UTM hemisphere (e.g. UTM 36N)" Tag="Hemisphere"/>
                                            <ComboBoxItem Content="Hemisphere + grid zone designation" Tag="Both"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource InfoPanelStyle}" Margin="0,10,0,0" Padding="10">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Height="170" CornerRadius="7" BorderBrush="#2D739A" BorderThickness="1" ClipToBounds="True" Background="#101C27">
                                            <Grid AutomationProperties.Name="Dynamic map grid and UTM preview">
                                                <!-- Image and overlays share one viewport so resizing cannot crop one independently of the other. -->
                                                <Viewbox Stretch="Uniform" IsHitTestVisible="False">
                                                  <Grid Width="1000" Height="375">
                                                    <Image Source="pack://application:,,,/Assets/Options/map-grid-preview.png"
                                                           Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Canvas Width="1000" Height="375" ClipToBounds="True">
                                                        <Canvas Width="1000" Height="375"
                                                                Visibility="{Binding IsChecked, ElementName=LongitudeLinesCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Line X1="83" Y1="0" X2="83" Y2="375" Stroke="{Binding ColorHex, ElementName=LongitudeColorPicker}" StrokeThickness="3"/>
                                                            <Line X1="167" Y1="0" X2="167" Y2="375" Stroke="{Binding ColorHex, ElementName=LongitudeColorPicker}" StrokeThickness="3"/>
