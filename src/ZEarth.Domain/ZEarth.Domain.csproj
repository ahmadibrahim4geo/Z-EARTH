    <RepositoryUrl>https://github.com/ahmadibrahim4geo/Z-EARTH</RepositoryUrl>
    <Company>Z EARTH Desktop</Company>
    <Product>Z EARTH Desktop GIS</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaxRev.Gdal.Core" Version="3.13.3.583" />
    <PackageReference Include="MaxRev.Gdal.WindowsRuntime.Minimal" Version="3.13.3.583" />
