<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZEarth.Globe</RootNamespace>
    <AssemblyName>ZEarth.Globe</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Ahmad Ibrahim</Authors>
    <!-- License of this project's original code only; dependencies and embedded assets have separate terms. -->
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ahmadibrahim4geo/Z-EARTH</RepositoryUrl>
    <Company>Z EARTH Desktop</Company>
    <Product>Z EARTH Desktop GIS</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZEarth.Domain\ZEarth.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
