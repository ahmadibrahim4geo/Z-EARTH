# Z Earth Desktop .gitignore

# External repositories
/rea/

# Build outputs
**/bin/
**/obj/
**/dist/
*.exe
*.dll
*.pdb

# IDE and tooling
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Temp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.log
*.cache

# Local, privacy-sensitive per-project agent history; never commit personal logs
.agent-development-log/

# Python cache
__pycache__/
*.py[cod]

# Local test & evidence outputs
.test-temp/
native-evidence/
reference-evidence/
ui-icon-evidence/
